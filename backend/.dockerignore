# Keep the Docker build context small and reproducible.
.venv/
.git/
.gitignore
.github/

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Tests and dev-only files are not part of the runtime image
tests/
conftest.py

# Local secrets and editor cruft must never enter an image
.env
.env.*
!.env.*.example
*.sqlite3
.DS_Store
