        "name": "org-admin",
        "description": "Organization administrator who manages users and scenarios within their org",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "instructor",
        "description": "Instructor who creates scenarios and reviews student training sessions",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "student",
        "description": "Student who participates in ATC training scenarios",
        "composite": false,
        "clientRole": false
      }
    ]
  },
