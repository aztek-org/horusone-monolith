# Backend Docker environment template
# Copy to .env.docker and fill in your values
# This file is used by docker-compose.yml

ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000

# Keycloak demo users (baked into the realm on first import). docker compose
# requires these via ${VAR:?}; set your own values — they are not committed.
DEMO_ADMIN_PASSWORD=change-me
DEMO_USER_PASSWORD=change-me

# Database — set automatically by docker-compose.yml from service names
# DATABASE_URL=postgresql+asyncpg://horus:horus@postgres:5432/horus_db

# Language model — Ollama is the primary provider
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3:latest
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_FALLBACK_PROVIDER=groq
LLM_ALLOW_EXTERNAL_FALLBACK=false
LLM_INTERRUPT_BEFORE_RESPONSE=false
GROQ_API_KEY=

# Aviation weather (auto uses NOAA AWC in production)
WEATHER_PROVIDER=auto
WEATHER_BASE_URL=https://aviationweather.gov/api/data
WEATHER_TIMEOUT_SECONDS=10.0

# Whisper Configuration
WHISPER_MODEL=base
WHISPER_LANGUAGE=auto

# TTS Configuration
TTS_LANGUAGE=en

# Scene registry (blank uses the packaged default-v1 Scene)
SCENES_PATH=

# Audio Processing
SAMPLE_RATE=16000
CHUNK_SIZE=1024
AUDIO_FORMAT=wav

# Radio Effects
ENABLE_RADIO_EFFECTS=true
NOISE_LEVEL=0.02
STATIC_LEVEL=0.01

# CORS — set to your Cloudflare Pages domain in production
CORS_ORIGINS=https://your-project.pages.dev,https://yourdomain.com

# Redis — set automatically by docker-compose.yml
# REDIS_URL=redis://redis:6379/0

# Keycloak / Authentication
# KEYCLOAK_ISSUER_URL=http://keycloak:8080/realms/horus
KEYCLOAK_CLIENT_ID=horus-api
AUTH_ENABLED=true

# Keycloak container secrets (used by docker-compose.yml for the keycloak service)
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak

# Logging
LOG_LEVEL=INFO
