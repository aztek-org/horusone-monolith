# Production environment template
# Copy to .env.prod and replace every placeholder before starting the backend.
#
# This file has two consumers:
#   1. Docker Compose interpolation — `docker compose ... --env-file .env.prod`
#      (see scripts/deploy.sh and the Makefile) reads the block below.
#   2. The backend container's own settings — the app variables further down.
# Keep both in one file so `cp .env.prod.example .env.prod` is enough.

# --- Docker Compose interpolation (secrets & hostnames) ---------------------
# Replace every `replace-me`/example value. There are no safe defaults here:
# compose leaves these empty if unset, which breaks postgres, redis and keycloak.
POSTGRES_USER=horus
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
KEYCLOAK_ADMIN_PASSWORD=replace-me
KEYCLOAK_DB_PASSWORD=replace-me
DEMO_ADMIN_PASSWORD=replace-me
DEMO_USER_PASSWORD=replace-me
ACME_EMAIL=ops@example.com
API_HOSTNAME=api.example.com
KEYCLOAK_HOSTNAME=auth.example.com

# --- Backend application settings ------------------------------------------
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# Required production services
DATABASE_URL=postgresql+asyncpg://horus:replace-me@db.example:5432/horus_db
REDIS_URL=redis://redis.example:6379/0
CORS_ORIGINS=https://app.example.com
KEYCLOAK_ISSUER_URL=https://auth.example.com/realms/horus
KEYCLOAK_CLIENT_ID=horus-api

# Language model
LLM_PROVIDER=ollama
LLM_BASE_URL=http://llm.example.com:11434
LLM_MODEL=llama3.2:3b
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=150
LLM_TIMEOUT_SECONDS=120
LLM_ALLOW_EXTERNAL_FALLBACK=false
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=

# Instructor override (HITL): when true the live graph pauses before generating
# the ATC response so an instructor can review or replace it. Off by default.
LLM_INTERRUPT_BEFORE_RESPONSE=false

# Groq fallback is opt-in only. Setting LLM_ALLOW_EXTERNAL_FALLBACK=true sends
# prompts off the VPS to the configured fallback provider; do not enable it
# unless that data transfer is explicitly approved.
GROQ_API_KEY=

# Knowledge retrieval
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_EMBEDDING_DIMENSIONS=768
KNOWLEDGE_TOP_K=5
KNOWLEDGE_DEFAULT_CHUNK_QUOTA=10

# Tracing
TRACE_RETENTION_DAYS=90
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# Scene registry (blank uses the packaged default-v1 Scene)
SCENES_PATH=

# --- Backups (host-side scripts; not read by the container) ----------------
# backup.sh encrypts every dump with age before it touches disk. Set
# BACKUP_AGE_RECIPIENT to the age public key (or a recipients file) whose
# PRIVATE key is kept off this host. Create the pair on your workstation with
# `age-keygen -o ~/.config/age/horus-backup.key` and paste the printed public
# key here. Without it backup.sh refuses to run unless you pass --no-encrypt.
BACKUP_AGE_RECIPIENT=age1replace-me

# Offsite copy via rclone (optional, recommended). Configure the remote once
# with `rclone config`, then set a target such as `horus-backups:horus-db`.
# Leave empty for local-only backups.
BACKUP_RCLONE_REMOTE=
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_REMOTE_RETENTION_DAYS=30
