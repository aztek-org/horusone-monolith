# Environment Configuration
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Keycloak demo users (baked into the realm on first import). docker compose
# requires these via ${VAR:?}; set your own values — they are not committed.
DEMO_ADMIN_PASSWORD=change-me
DEMO_USER_PASSWORD=change-me

# Language model configuration
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=150
LLM_TIMEOUT_SECONDS=120
LLM_ALLOW_EXTERNAL_FALLBACK=false
LLM_FALLBACK_API_KEY=

# Instructor override (HITL): when true the live graph pauses before generating
# the ATC response so an instructor can review or replace it. Off by default.
LLM_INTERRUPT_BEFORE_RESPONSE=false

# Knowledge retrieval
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_EMBEDDING_DIMENSIONS=768
KNOWLEDGE_TOP_K=5
KNOWLEDGE_DEFAULT_CHUNK_QUOTA=10

# Aviation weather (auto uses NOAA AWC in production and bundled reports elsewhere)
WEATHER_PROVIDER=auto
WEATHER_BASE_URL=https://aviationweather.gov/api/data
WEATHER_TIMEOUT_SECONDS=10.0

# Tracing
TRACE_RETENTION_DAYS=90
OTEL_EXPORTER_OTLP_ENDPOINT=

# Whisper Configuration (for STT)
# WHISPER_LANGUAGE accepts en, es, or auto for auto-detection.
# Do not put the allowed values in an inline comment: the settings loader reads
# everything after "=" as the value, so "en  # en, es" is loaded verbatim.
WHISPER_MODEL=base
WHISPER_LANGUAGE=en

# TTS Configuration
# TTS_LANGUAGE accepts en or es.
TTS_LANGUAGE=en

# Scene registry (blank uses the packaged default-v1 Scene)
SCENES_PATH=

# Audio Processing
SAMPLE_RATE=16000
CHUNK_SIZE=1024
AUDIO_FORMAT=wav

# Radio Effects
ENABLE_RADIO_EFFECTS=true
NOISE_LEVEL=0.02
STATIC_LEVEL=0.01

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# Database
DATABASE_URL=postgresql+asyncpg://horus:horus@localhost:5432/horus_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Keycloak / Authentication
KEYCLOAK_ISSUER_URL=http://localhost:8180/realms/horus
# Optional: comma-separated issuer aliases for local direct vs Traefik auth switching.
KEYCLOAK_ISSUER_ALIASES=http://localhost:8080/realms/horus,http://auth.localhost/realms/horus
KEYCLOAK_CLIENT_ID=horus-api
AUTH_ENABLED=true

# Logging
LOG_LEVEL=INFO
