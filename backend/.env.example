# Environment Configuration
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Whisper Configuration (for STT)
WHISPER_MODEL=base
WHISPER_LANGUAGE=en  # en, es, or auto for auto-detection

# TTS Configuration
TTS_LANGUAGE=en  # en or es

# Audio Processing
SAMPLE_RATE=16000
CHUNK_SIZE=1024
AUDIO_FORMAT=wav

# Radio Effects
ENABLE_RADIO_EFFECTS=true
NOISE_LEVEL=0.02
STATIC_LEVEL=0.01

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+asyncpg://horus:horus@localhost:5432/horus_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Keycloak / Authentication
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/horus
KEYCLOAK_CLIENT_ID=horus-api
AUTH_ENABLED=true

# Logging
LOG_LEVEL=INFO
