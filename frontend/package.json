{
  "name": "horus-frontend-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:squawk": "turbo run dev --filter=squawk",
    "dev:tower": "turbo run dev --filter=tower",
    "dev:hangar": "turbo run dev --filter=hangar",
    "build": "turbo run build",
    "build:squawk": "turbo run build --filter=squawk",
    "build:tower": "turbo run build --filter=tower",
    "build:hangar": "turbo run build --filter=hangar",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf .turbo",
    "postinstall": "turbo run prepare"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "^1.11.0",
    "@nuxt/test-utils": "^4.0.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@oxc-minify/binding-linux-x64-gnu": "^0.114.0",
    "@oxc-parser/binding-linux-x64-gnu": "^0.114.0",
    "@oxc-transform/binding-linux-x64-gnu": "^0.114.0",
    "@types/leaflet": "^1.9.21",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "happy-dom": "20.8.9",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.60.1",
      "vue": "3.5.31",
      "@vue/runtime-core": "3.5.31",
      "@vue/runtime-dom": "3.5.31",
      "@vue/reactivity": "3.5.31",
      "@vue/shared": "3.5.31",
      "@vue/compiler-core": "3.5.31",
      "@vue/compiler-dom": "3.5.31",
      "@vue/compiler-sfc": "3.5.31",
      "@vue/compiler-ssr": "3.5.31",
      "h3": "1.15.9",
      "h3-next": "npm:h3@2.0.1-rc.20",
      "defu": "6.1.6",
      "flatted": "3.4.2",
      "yaml": "2.8.3",
      "brace-expansion@1": "1.1.13",
      "brace-expansion@2": "2.0.3",
      "brace-expansion@5": "5.0.5",
      "tinyglobby>picomatch": "4.0.4",
      "anymatch>picomatch": "2.3.2",
      "vite>picomatch": "4.0.4",
      "vite>yaml": "2.8.3",
      "readdirp>picomatch": "2.3.2",
      "unplugin>picomatch": "4.0.4",
      "unimport>picomatch": "4.0.4",
      "@stylistic/eslint-plugin>picomatch": "4.0.4",
      "@nuxt/icon>picomatch": "4.0.4",
      "vitest>picomatch": "4.0.4",
      "nuxt>picomatch": "4.0.4",
      "micromatch>picomatch": "2.3.2",
      "node-forge": "1.4.0",
      "readdir-glob>minimatch": "5.1.8",
      "editorconfig>minimatch": "9.0.7",
      "glob>minimatch": "9.0.7",
      "serialize-javascript": "7.0.5",
      "tar": "7.5.13",
      "lodash": "4.18.1"
    }
  },
  "dependencies": {
    "remove": "^0.1.5"
  }
}
