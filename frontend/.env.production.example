# Frontend production environment template
# For Cloudflare Pages — set these in the Cloudflare dashboard
# (Settings → Environment variables → Production)
# Do NOT commit actual values to git.

# URL of the backend API on your VPS
NUXT_PUBLIC_API_URL=https://api.yourdomain.com

# WebSocket endpoint on your VPS (must use wss:// in production)
NUXT_PUBLIC_WS_URL=wss://api.yourdomain.com/ws/voice

# Keycloak issuer base URL (realm is configured separately)
NUXT_PUBLIC_KEYCLOAK_URL=https://auth.yourdomain.com
NUXT_PUBLIC_KEYCLOAK_REALM=horus
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=horus-web

# Frontend app URLs used for role-based app handoff after login
NUXT_PUBLIC_HANGAR_URL=https://hangar.yourdomain.com
NUXT_PUBLIC_TOWER_URL=https://tower.yourdomain.com
NUXT_PUBLIC_SQUAWK_URL=https://squawk.yourdomain.com

# Main login gateway app (recommended: hangar URL)
NUXT_PUBLIC_AUTH_GATEWAY_URL=https://hangar.yourdomain.com
